# v1.0.5.14: share worker output files — LLM-generated content
# (markdown / html / svg / png infographics).  When the manifest
# specifies a custom output_path (or the default $HOME/.moni/output
# path resolution fails), these can land in the repo root or in
# per-format subdirs.  They're run artifacts, not source — gitignore
# them so they don't accidentally end up in PRs.
infographic/
share_output/
# Root-level share outputs (historical pattern: scripts dump to cwd)
/*_infographic.png
/*-infographic.png
/tmp/*.png

# Local dev helper — bypasses sandbox -c block (sandbox BLOCKS
# `python3 -c "..."` even with approval, so this file is the
# workaround).  Committed scripts should use web.sh / web-8901.sh.
scripts/dev_*.py

