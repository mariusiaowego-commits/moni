{# v1.0.24 简报 HTML — 事实核查证据段 (本简报)
   Rendered by moni.share.enrichment.build_evidence_section_html
   Context: total, checked, failed, method, snapshot_at, articles[]
#}
<section class="fact-check-evidence" aria-label="事实核查证据">
  <h3>事实核查证据 (本简报)</h3>
  <div class="rollup">
    <span class="badge web_search">已联网核查: {{ checked }}/{{ total }} 篇{% if failed %} ({{ failed }} 篇失败降级){% endif %}</span>
    <span class="meta">方法: {{ method }} · 时效: {{ snapshot_at }}</span>
  </div>
  <ol class="evidence-articles">
{% for a in articles %}
    <li>
      <h4>{{ a.title }}</h4>
{% if a.ok %}
      <p class="conclusion">{{ a.conclusion }}</p>
      <ol class="evidence-list">
{% for e in a.evidence %}
        <li>
          <a href="{{ e.url }}" target="_blank" rel="noopener">[{{ loop.index }}] {{ e.domain }}</a>
          <p class="snippet">{{ e.snippet }}</p>
        </li>
{% endfor %}
      </ol>
{% else %}
      <p class="unverified">（未联网核查，{{ a.fail_reason }}）</p>
{% endif %}
    </li>
{% endfor %}
  </ol>
</section>
