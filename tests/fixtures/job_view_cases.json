          "queue_total": 3
        }
      },
      "expect": {
        "phase": "queued",
        "show": true,
        "busy": true,
        "text": "排队中 · 第 2/3 位",
        "detail": "已等待 1 分 05 秒",
        "tone": "queued",
        "retryable": false
      }
    },
    {
