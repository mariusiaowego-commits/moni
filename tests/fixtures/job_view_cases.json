        "busy": false,
        "text": "",
        "tone": "idle",
        "ignore": false
      }
    },
    {
      "name": "queued with position and total",
      "input": {
        "slot": "fact_check",
        "articleId": "a1",
        "job": {
          "id": "j1",
          "task_type": "fact_check_plus",
          "article_id": "a1",
